COMPOSE_PROFILES=core
COMPOSE_PROJECT_NAME=ercs-deploy

# Django APP_ENVIRONMENT (PROD|STAGING|ALPHA). Drives cookie names + health-check thresholds.
APP_ENVIRONMENT=PROD
# vite APP_ENVIRONMENT for the web apps (production|staging|testing|alpha-<n>|development)
WEB_APP_ENVIRONMENT=production

# Postgres
# NOTE: Password: Use openssl rand -base64 48 | tr -dc 'A-Za-z0-9_@#%^+=-' | head -c 24
POSTGRES_DB=ercs
POSTGRES_USER=
POSTGRES_PASSWORD=

# Caddy
# NOTE: site addresses only -- no path. A path here would scope the whole
# Caddy site block to that path.
# NOTE: keep these in sync with APP_DOMAIN / FRONTEND_DOMAIN /
# ADDITIONAL_TRUSTED_ORIGINS in ./env/backend.env.
CADDY_EMAIL=ercs@example.org
CADDY_HOST_BACKEND=https://api.example.org
CADDY_HOST_FRONTEND=https://ercs.example.org
CADDY_HOST_CMS=https://cms.example.org
