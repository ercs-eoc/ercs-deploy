DJANGO_SECRET_KEY=
DEBUG=false
APP_DOMAIN=https://api.example.org
FRONTEND_DOMAIN=https://ercs.example.org
ADDITIONAL_TRUSTED_ORIGINS=https://cms.example.org
SESSION_COOKIE_DOMAIN=.example.org
CSRF_COOKIE_DOMAIN=.example.org

# LLM
LLM_MODEL_NAME=qwen2.5vl:7b
LLM_OLLAMA_BASE_URL=
LLM_EMBEDDING_MODEL=nomic-embed-text:v1.5
LLM_USE_OPENROUTER=false
OPENROUTER_API_KEY=
LLM_USE_SENTENCE_TRANSFORMERS=false
SENTENCE_TRANSFORMER_MODEL_NAME=sentence-transformers/all-mpnet-base-v2

# Sentry
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILE_SAMPLE_RATE=0.2
