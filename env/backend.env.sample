DJANGO_SECRET_KEY=
DEBUG=false
APP_DOMAIN=https://api.example.org
FRONTEND_DOMAIN=https://ercs.example.org
ADDITIONAL_TRUSTED_ORIGINS=https://cms.example.org
SESSION_COOKIE_DOMAIN=.example.org
CSRF_COOKIE_DOMAIN=.example.org

# Optional: e.g. git tag, sent to Sentry as the release
APP_RELEASE=

# NOTE: LLM_* (ollama) are set in ../.env -- compose overrides any value here.

# Kobo (ERCS EOC Toolkit)
KOBO_DOMAIN=https://kobo.ifrc.org
KOBO_ACCESS_TOKEN=

# Sentry
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILE_SAMPLE_RATE=0.2
