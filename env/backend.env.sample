# vim: filetype=bash
# ercs-backend secrets / per-deployment config.
# NOTE: docker-compose.yaml's `environment:` block WINS over this file. Only put
# variables here that compose does not already set (see backend/main/settings.py
# for the full list of supported variables).
# XXX: This file is committed -- keep real secrets in ./backend.env only.

# Django
# NOTE: openssl rand -base64 64 | tr -d '\n'
DJANGO_SECRET_KEY=
DEBUG=false

# Domains
# NOTE: settings.py urlparse()s these -- the scheme is REQUIRED. Without it
# APP_DOMAIN.hostname is None (breaks ALLOWED_HOSTS) and the https branch that
# sets SECURE_PROXY_SSL_HEADER / secure cookies never runs.
# Keep in sync with CADDY_HOST_* in ../.env
APP_DOMAIN=https://api.example.org
FRONTEND_DOMAIN=https://ercs.example.org
# The CMS is a third origin hitting the same /graphql/ endpoint.
# CSRF_TRUSTED_ORIGINS / CORS_ALLOWED_ORIGINS: scheme required (Django 4+ check 4_0.E001)
ADDITIONAL_TRUSTED_ORIGINS=https://cms.example.org
# Extra hosts beyond APP_DOMAIN's hostname (comma separated, no scheme)
# ADDITIONAL_ALLOWED_HOSTS=
# Cookie domain must be a parent of every host above, or the browser drops the cookie.
SESSION_COOKIE_DOMAIN=.example.org
CSRF_COOKIE_DOMAIN=.example.org

# LLM
# Chat completions run on Ollama by default; set LLM_USE_OPENROUTER=true to
# route them through OpenRouter instead (OpenRouter has no embeddings endpoint).
LLM_MODEL_NAME=qwen2.5vl:7b
LLM_OLLAMA_BASE_URL=
LLM_EMBEDDING_MODEL=nomic-embed-text:v1.5
LLM_USE_OPENROUTER=false
OPENROUTER_API_KEY=
# Embeddings independently fall back to local sentence-transformers
LLM_USE_SENTENCE_TRANSFORMERS=false
SENTENCE_TRANSFORMER_MODEL_NAME=sentence-transformers/all-mpnet-base-v2

# Sentry
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILE_SAMPLE_RATE=0.2

# S3 storage (compose defaults to the filesystem + Caddy; set AWS_S3_ENABLED=true to switch)
# AWS_S3_ENABLED=false
# AWS_S3_ENDPOINT_URL=
# AWS_S3_ACCESS_KEY_ID=
# AWS_S3_SECRET_ACCESS_KEY=
# AWS_S3_REGION_NAME=
# AWS_S3_MEDIA_BUCKET_NAME=
# AWS_S3_STATIC_BUCKET_NAME=
